<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinGetJet.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:v="using:WinGetJet.Views"
    xmlns:m="using:WinGetJet.Models"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind v:ViewConvert.Format('{0} apps found ({1} updates available)', ViewModel.AppsView.Count, ViewModel.UpdateCount), Mode=OneWay}" />

            <CheckBox Grid.Column="1" Content="Show only apps with updates" IsChecked="{x:Bind ViewModel.ShowOnlyUpdates, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="12,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Publisher" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Version" FontWeight="SemiBold" />
            </Grid>

            <!-- Rows (read-only) -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AppsView}" SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:AppModel">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <v:AppIcon VerticalAlignment="Center" Icon="{x:Bind (media:ImageSource)Icon, Mode=OneWay, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                           IsUpdateAvailable="{x:Bind IsUpdateAvailable, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind Publisher.Text, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Details view -->
            <Grid Grid.Column="1" Grid.RowSpan="2" Width="450" Margin="12,0,0,0" CornerRadius="8" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <TextBlock Text="Select an app to see its details." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind v:ViewConvert.IsNotVisible(ViewModel.SelectedApp), Mode=OneWay}" />

                <ScrollViewer Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp), Mode=OneWay}">
                    <StackPanel Padding="16" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <v:AppIcon Width="48" Height="48" VerticalAlignment="Top" Icon="{x:Bind (media:ImageSource)ViewModel.SelectedApp.Icon, Mode=OneWay, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                       IsUpdateAvailable="{x:Bind ViewModel.SelectedApp.IsUpdateAvailable, Mode=OneWay, FallbackValue=False}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.Publisher.Text, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.Publisher.Text), Mode=OneWay, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Installed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedApp.Version, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Grid.Row="1" Text="Available" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="VersionComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.SelectedApp.AvailableVersions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedApp.SelectedVersion, Mode=OneWay}" SelectionChanged="VersionComboBoxSelectionChanged" DisplayMemberPath="Version" />
                            <TextBlock Grid.Row="2" Text="Publisher" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedApp.Publisher.Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Visibility="{x:Bind v:ViewConvert.IsNotVisible(ViewModel.SelectedApp.Publisher.Url), Mode=OneWay, FallbackValue=Visible}" />
                            <HyperlinkButton Grid.Row="2" Grid.Column="1" Padding="0" VerticalAlignment="Top" NavigateUri="{x:Bind ViewModel.SelectedApp.Publisher.Url, Mode=OneWay, FallbackValue={x:Null}}"
                                             Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.Publisher.Url), Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.Publisher.Text, Mode=OneWay}" TextWrapping="Wrap" />
                            </HyperlinkButton>
                            <TextBlock Grid.Row="3" Text="License" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedApp.License.Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Visibility="{x:Bind v:ViewConvert.IsNotVisible(ViewModel.SelectedApp.License.Url), Mode=OneWay, FallbackValue=Visible}" />
                            <HyperlinkButton Grid.Row="3" Grid.Column="1" Padding="0" VerticalAlignment="Top" NavigateUri="{x:Bind ViewModel.SelectedApp.License.Url, Mode=OneWay, FallbackValue={x:Null}}"
                                             Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.License.Url), Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.License.Text, Mode=OneWay}" TextWrapping="Wrap" />
                            </HyperlinkButton>
                            <TextBlock Grid.Row="4" Text="Copyright" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedApp.Copyright, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                        
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.PackageUrl), Mode=OneWay, FallbackValue=Collapsed}">
                                <FontIcon Glyph="&#xE774;" FontSize="16" VerticalAlignment="Center" />
                                <HyperlinkButton Content="Homepage" Padding="0,0,0,2" VerticalAlignment="Center" 
                                                 NavigateUri="{x:Bind ViewModel.SelectedApp.PackageUrl, Mode=OneWay, FallbackValue={x:Null}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.PublisherSupportUrl), Mode=OneWay, FallbackValue=Collapsed}">
                                <FontIcon Glyph="&#xEA6B;" FontSize="16" VerticalAlignment="Center" />
                                <HyperlinkButton Content="Support" Padding="0,0,0,2" VerticalAlignment="Center" 
                                                 NavigateUri="{x:Bind ViewModel.SelectedApp.PublisherSupportUrl, Mode=OneWay, FallbackValue={x:Null}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind v:ViewConvert.IsAnyVisible(ViewModel.SelectedApp.ReleaseNotes.Text, ViewModel.SelectedApp.ReleaseNotes.Url), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Text="Release notes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.ReleaseNotes.Url), Mode=OneWay, FallbackValue=Collapsed}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center" />
                                <HyperlinkButton Content="Release notes" Padding="0,0,0,2" VerticalAlignment="Center" NavigateUri="{x:Bind ViewModel.SelectedApp.ReleaseNotes.Url, Mode=OneWay, FallbackValue={x:Null}}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedApp.ReleaseNotes.Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" 
                                    Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.ReleaseNotes.Text), Mode=OneWay, FallbackValue=Collapsed}"/>
                        </StackPanel>

                        <StackPanel Spacing="0" Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.Documentations), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Text="Links" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedApp.Documentations, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:AppTextLink">
                                        <HyperlinkButton Content="{x:Bind Text}" Padding="0,2" NavigateUri="{x:Bind Url}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.Description), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Text="Description" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedApp.Description, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind v:ViewConvert.IsVisible(ViewModel.SelectedApp.Tags), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Text="Tags" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind v:ViewConvert.Join(ViewModel.SelectedApp.Tags), Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" />
    </Grid>
</Page>