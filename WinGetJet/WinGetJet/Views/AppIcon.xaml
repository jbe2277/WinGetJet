<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinGetJet.Views.AppIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:WinGetJet.Views">

    <Grid x:Name="RootGrid" Width="24" Height="24">
        <FontIcon x:Name="PlaceholderIcon" Glyph="&#xE7B8;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Visibility="{x:Bind v:ViewConvert.IsNotVisible(Icon), Mode=OneWay}" />
        <Image x:Name="IconImage" Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" />
        <Border x:Name="UpdateBadge" Width="14" Height="14" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                Background="{ThemeResource AccentFillColorDefaultBrush}" ToolTipService.ToolTip="Update available"
                Visibility="{x:Bind v:ViewConvert.BoolToVisibility(IsUpdateAvailable), Mode=OneWay}">
            <FontIcon x:Name="UpdateGlyph" Glyph="&#xE74A;" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
